# --- Tracker Financiero · configuración ---
# Clave de la API de Holded (Ajustes > Desarrolladores > API). Si se deja vacía,
# el sistema arranca automáticamente en modo demo con datos sintéticos.
HOLDED_API_KEY=

# true  -> usa siempre el fixture local data/sample_holded_data.json
# false -> consulta la API de Holded (con fallback automático al mock si falla)
DEMO_MODE=true

# Opcionales
HOLDED_BASE_URL=https://api.holded.com/api
HOLDED_TIMEOUT=20
HOLDED_MAX_RETRIES=5
# Meses de histórico a descargar en modo real
HOLDED_LOOKBACK_MONTHS=12
# true -> en modo real, si Holded falla se muestra el error en vez de caer al mock
HOLDED_STRICT=false
